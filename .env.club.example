# Shared writable path for club_admin.py and club_bot.py (same host/volume).
CLUB_DB_PATH=/data/club.db
CLUB_MEDIA_DIR=/data/club-media
CLUB_ADMIN_HOST=127.0.0.1
CLUB_ADMIN_PORT=8080
CLUB_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARS
CLUB_ADMIN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
CLUB_ADMIN_ORIGIN=https://REPLACE_WITH_ADMIN_DOMAIN
CLUB_PUBLIC_URL=https://REPLACE_WITH_ADMIN_DOMAIN
CLUB_SITE_URL=https://REPLACE_WITH_HOMEPAGE_DOMAIN
CLUB_COOKIE_SECURE=1
DISCORD_TOKEN=REPLACE_WITH_BOT_TOKEN
CLUB_WELCOME_CHANNEL_ID=
